# The keys the release's Secret must hold, and where each value comes from. Copy to deploy/.env,
# fill it in, and create the Secret with the command in deploy/helm/README.md § Prerequisites.
#
# This file is the SECRETS only. Non-secret configuration is values.yaml `config`, which is
# reviewable in git — do not move a key here to avoid a review.
#
# NOTHING VALIDATES THESE AT STARTUP. The three mistakes below fail silently at runtime rather
# than refusing to boot:
#   * the two URLs naming the SAME database — ADK creates its own tables in the business schema
#   * ADK_SESSION_DB_URL missing the `+psycopg` async driver — every turn 500s at the session store
#   * a URL copied from the repository root .env.example, which points at localhost:5434

# --- The model ---------------------------------------------------------------
# Gemini API key. The same one the local .env holds.
GOOGLE_API_KEY=

# --- Telegram ----------------------------------------------------------------
# From BotFather.
TELEGRAM_BOT_TOKEN=
# Chosen here, then handed to Telegram with setWebhook -d secret_token=... (README § Against real
# Telegram). With this unset the webhook refuses every delivery, which is the safe direction.
TELEGRAM_WEBHOOK_SECRET=

# --- Databases ---------------------------------------------------------------
# Two databases on one managed instance. SYNC driver for the business schema, ASYNC for ADK's
# session store, and never the same database (agent-platform docs/ADK_LESSONS_LEARNED.md §6a-6b).
# DO Managed Postgres requires sslmode=require.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:25060/aziza?sslmode=require
ADK_SESSION_DB_URL=postgresql+psycopg://USER:PASSWORD@HOST:25060/aziza_sessions?sslmode=require

# Signs the join link the QR encodes. Its own secret, never the webhook's and never the bot
# token: sharing one would mean rotating the webhook to rotate the links. Empty refuses every
# join. Generate:  python -c "import secrets; print(secrets.token_urlsafe(32))"
JOIN_LINK_SECRET=
# Set only for the length of a rotation, then cleared.
JOIN_LINK_SECRET_PREVIOUS=

