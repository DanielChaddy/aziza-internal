# Copy to .env and fill in what differs from these defaults. Every variable here has a safe code
# default in aziza_adk/config.py or in the channel package: a missing one degrades to safe/local,
# never crashes boot.

# --- Model -------------------------------------------------------------------
# Required for `adk web` and the eval. Not needed by pytest.
GOOGLE_API_KEY=
AGENT_MODEL=gemini-3.5-flash
# What reads a voice note. Its own key: downgrading the agent must not change what hears a
# specialist.
TRANSCRIBE_MODEL=gemini-3.5-flash

# --- Databases ---------------------------------------------------------------
# TWO databases, TWO drivers. ADK owns its own entirely and must never be pointed at the
# business one, and its URL must use the async scheme or every turn 500s at the session store.
DATABASE_URL=postgresql://aziza:aziza@localhost:5434/aziza
ADK_SESSION_DB_URL=postgresql+psycopg://aziza:aziza@localhost:5434/aziza_sessions

# --- Assistant ---------------------------------------------------------------
APP_NAME=aziza_adk
SALON_NAME=Salón Aziza
TIMEZONE=America/Santo_Domingo

# --- Money -------------------------------------------------------------------
# The specialist's share of a services subtotal, before tip. Tips are theirs in full.
COMMISSION_PCT=40

# --- Serving -----------------------------------------------------------------
MODEL_TURN_TIMEOUT_SECONDS=60

# --- Telegram ----------------------------------------------------------------
# Register the webhook with the SAME secret, or every delivery is refused:
#   curl "https://api.telegram.org/bot<TOKEN>/setWebhook" \
#     -d url=https://<host>/webhook -d secret_token=<TELEGRAM_WEBHOOK_SECRET>
# With no secret the webhook refuses everything; with no token an outbound send is a logged no-op.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
# Comma-separated user ids. NON-EMPTY restricts the webhook to these senders; empty means no
# restriction. This is coarser than the specialist table, which is the real gate.
TELEGRAM_ALLOWED_USER_IDS=
TELEGRAM_MAX_DELIVERY_AGE_S=900
TELEGRAM_TYPING_INDICATOR_ENABLED=true
TELEGRAM_MEDIA_MAX_BYTES=5242880
# Only for a self-hosted Bot API server.
TELEGRAM_API_BASE=

# --- End-of-day summary ------------------------------------------------------
# `simulate` logs what would be sent and RECORDS NOTHING, so a dry run cannot mark a day as
# already reported. Only `live` sends and records.
SUMMARY_SEND_MODE=simulate

# --- Telemetry ---------------------------------------------------------------
# Unset installs nothing and the service acquires no new failure mode by being observable.
OTEL_EXPORTER_OTLP_ENDPOINT=

# --- Gates -------------------------------------------------------------------
# 1 turns an absent database from skips into failures.
REQUIRE_DB=
